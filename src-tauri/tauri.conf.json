{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Usage Meter",
  "version": "1.0.5",
  "identifier": "com.ai-usage-meter.desktop",
  "mainBinaryName": "AI-Usage-Meter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Usage Meter",
        "width": 960,
        "height": 680,
        "minWidth": 600,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "visible": true
      },
      {
        "label": "compact",
        "title": "AI Usage Meter 悬浮卡片",
        "url": "index.html?view=floating&style=card",
        "width": 276,
        "height": 150,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "transparent": true,
        "backgroundColor": [0, 0, 0, 0]
      },
      {
        "label": "orb",
        "title": "",
        "url": "index.html?view=floating&style=orb",
        "width": 230,
        "height": 68,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "transparent": true,
        "backgroundColor": [0, 0, 0, 0]
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "AI Usage Meter",
    "copyright": "Copyright © 2026 AI Usage Meter",
    "homepage": "https://github.com/clockclock1/ai-usage-meter",
    "category": "Utility",
    "shortDescription": "Multi-platform AI usage meter for Windows",
    "longDescription": "Windows desktop app for quota and token usage across multiple AI platforms. Currently supports Codex and Cursor, with configurable sync, cached switching, and a dockable floating orb.",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "resources": {
      "../node_modules/@tokscale/cli-win32-*/bin/tokscale.exe": ""
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "startMenuFolder": "AI Usage Meter",
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  }
}
